<UserControl x:Class="WorkTogether.WPF._core.Form.ServiceCallForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WorkTogether.WPF._core.Form"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>

            <Border Background="#F9FAFB" Padding="15" CornerRadius="5" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TitleForm" Text="Effectuer une nouvelle intervention" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15"/>

                    <TextBlock Text="Début de la mise en place :" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <DatePicker x:Name="SelectedDate" />

                    <Grid Margin="0,0,0,10" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Unité :" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <ComboBox x:Name="Unit" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="FullLabel"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type d'intervention :" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ServiceCall" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"/>
                        </StackPanel>
                    </Grid>

                    <Frame x:Name="Btn" NavigationUIVisibility="Hidden"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
