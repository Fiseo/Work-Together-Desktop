<UserControl x:Class="WorkTogether.WPF.TechnicianView.ReallocationForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WorkTogether.WPF.Form"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- ... reste du code -->
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Bandeaux en haut -->
    <Border Background="#F9FAFB" Padding="15" CornerRadius="5" BorderBrush="#E5E7EB" BorderThickness="1" Grid.Row="0" Margin="20">
        <StackPanel>
            <TextBlock x:Name="TitleForm" Text="Sélectionnez une unité avant de continuer :" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15"/>

            <StackPanel x:Name="UnitPanel" Visibility="Collapsed">
                <TextBlock Text="Unité disponible :" Foreground="#6B7280" Margin="0,0,0,5"/>
                <ComboBox x:Name="Unit" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"  DisplayMemberPath="FullLabel"/>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Boutons -->
    <StackPanel x:Name="Btn" Grid.Row="2" Visibility="Collapsed">
    <Button Content="Sauvegarder" Height="35" Background="#10B981" Foreground="White" 
            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Save_Click" Margin="20,10,20,10" Grid.Row="2">
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
        </Button.Resources>
    </Button>

    <Button Content="Désélectionner" Height="35" Background="Blue" Foreground="White" 
            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Clear_Click" Visibility="Visible" Margin="20,0,20,10" Grid.Row="4">
        <Button.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
        </Button.Resources>
    </Button>

    <!-- Erreur -->
    <Border x:Name="ErrorBanner"
            Grid.Row="6"
            Background="#FEF2F2"
            BorderBrush="#FECACA"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8"
            Margin="20,0,20,14"
            Visibility="Collapsed">
        <TextBlock x:Name="Error"
                   Text=""
                   Foreground="#B91C1C"
                   FontSize="12" FontFamily="Segoe UI"
                   TextWrapping="Wrap"/>
    </Border>
    </StackPanel>
</Grid>
</UserControl>
