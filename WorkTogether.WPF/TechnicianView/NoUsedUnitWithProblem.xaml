<Page x:Class="WorkTogether.WPF.TechnicianView.NoUsedUnitWithProblem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WorkTogether.WPF.TechnicianView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NoUsedUnitWithProblem">

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <!-- Icône ou symbole -->
            <TextBlock Text="✓" FontSize="72" Foreground="#10B981" TextAlignment="Center" Margin="0,0,0,20"/>
            
            <!-- Titre -->
            <TextBlock Text="Aucun problème détecté" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#374151" 
                       TextAlignment="Center" 
                       Margin="0,0,0,10"/>
            
            <!-- Sous-titre -->
            <TextBlock Text="Toutes vos unités assignées fonctionnent correctement." 
                       FontSize="14" 
                       Foreground="#6B7280" 
                       TextAlignment="Center" 
                       Margin="0,0,0,30"
                       MaxWidth="400"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
